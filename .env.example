# ── AI Voice Chatbox / AgentCore configuration ──
# Copy this file to ".env" and fill in what you need.
# Everything is optional — the app runs with built-in NLP if no LLM is set.

# Port the web server listens on
PORT=3000

# ── LLM provider ──
# Choose one: "groq" (FREE cloud, recommended), "builtin" (no key), "openai", or "ollama"
LLM_PROVIDER=groq

# --- Groq: FREE LLM (recommended). Get a free key: https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama, local LLM (used when LLM_PROVIDER=ollama) ---
# Matches the PDF's Ollama + Llama3 stack. Run `ollama serve` locally first.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Public URL tunnel (optional) ──
# A custom subdomain to request from localtunnel (may not always be available)
TUNNEL_SUBDOMAIN=
