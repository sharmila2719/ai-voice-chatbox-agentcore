# ── AI ChatBot / AgentCore configuration ──
# Copy this file to ".env" and fill in your AWS credentials.

# Port the web server listens on
PORT=3000

# ── AWS LLM: Amazon Bedrock ──
# This project uses AWS technologies only. The language model runs on
# Amazon Bedrock via the Converse API. AgentCore + NLP handle orchestration.
LLM_PROVIDER=bedrock

# AWS region where Bedrock model access is enabled for your account
AWS_REGION=us-east-1

# --- AWS credentials ---
# Option 1: static keys (below)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
# Option 2: a shared profile from ~/.aws/credentials
# AWS_PROFILE=default
# Option 3: an IAM role (no keys needed) when running on AWS

# Bedrock model id — must be enabled in your account/region.
# Examples:
#   amazon.nova-lite-v1:0
#   anthropic.claude-3-5-sonnet-20240620-v1:0
#   meta.llama3-8b-instruct-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ── Public URL tunnel (optional) ──
TUNNEL_SUBDOMAIN=
